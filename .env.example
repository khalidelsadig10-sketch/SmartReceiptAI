# =========================================================
# SmartReceiptAI - Environment Variables
# =========================================================
# Copy this file to .env and fill in your values
# =========================================================

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Email (Resend)
RESEND_API_KEY=your_resend_api_key_here
MAIL_FROM=SmartReceiptAI <onboarding@resend.dev>
RESET_PASSWORD_URL=https://your-domain.up.railway.app/reset-password

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartreceiptai_v2
DB_USER=root
DB_PASSWORD=your_db_password_here

# JWT Security
JWT_SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_SECRET
